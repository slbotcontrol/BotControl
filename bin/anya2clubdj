#!/usr/bin/env bash

export PATH="/usr/local/bin:${PATH}"
[ -d /opt/homebrew/bin ] && {
  export PATH="/opt/homebrew/bin:${PATH}"
}

have_lb=$(type -p botctrl)
[ "${have_lb}" ] || {
  echo "ERROR: cannot locate botctrl in PATH"
  exit 1
}

# Run with -c argument to control Anya Ordinary as a Corrade Bot
# Default operation is to treat her like a Lifebots bot
if [ "$1" == "-c" ]; then
  # Check if online
  [ -f /usr/local/BotControl/lib/online ] || {
    echo "ERROR: cannot locate /usr/local/BotControl/lib/online"
    exit 1
  }
  source /usr/local/BotControl/lib/online
  co_bot_online Anya || {
    echo "Anya Ordinary does not appear to be online"
    exit 1
  }

  botctrl -a stand -c Anya >/dev/null 2>&1
  botctrl -a teleport -c Anya -l club >/dev/null 2>&1
  sleep 5
  botctrl -a wear_outfit -c Anya -O '** Legacy Basic Purple Top & Jeans **' >/dev/null 2>&1
  sleep 5
  botctrl -a sit -c Anya -u clubdj
else
  have_jq=$(type -p jq)
  [ "${have_jq}" ] || {
    echo "ERROR: cannot locate jq in PATH"
    exit 1
  }

  # Check if Bot is online and if not, login
  botctrl -a status -n Anya | jq -r '.status' | grep -i online >/dev/null || {
    botctrl -a login -n Anya -l club
    sleep 10
  }

  botctrl -a stand -n Anya >/dev/null 2>&1
  botctrl -a teleport -n Anya -l club
  sleep 5
  botctrl -a sit -n Anya -u clubdj
fi
